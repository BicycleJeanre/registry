{
  "name": "emilia-rose-registry",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/model.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-registry \"node --test tests/rules.test.mjs\"",
    "test:cloud": "node scripts/smoke_cloud.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.30.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
