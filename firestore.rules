rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validStaticSingle(itemId) {
      return itemId in ['22222222-2222-4222-8222-222222222222', '00000000-0000-4000-8000-000000000051', '00000000-0000-4000-8000-000000000055', '00000000-0000-4000-8000-000000000083', '00000000-0000-4000-8000-000000000016', '00000000-0000-4000-8000-000000000058', '00000000-0000-4000-8000-000000000059', '00000000-0000-4000-8000-000000000060', '00000000-0000-4000-8000-000000000026', '00000000-0000-4000-8000-000000000054', '00000000-0000-4000-8000-000000000017', '00000000-0000-4000-8000-000000000076', '00000000-0000-4000-8000-000000000048', '00000000-0000-4000-8000-000000000014', '00000000-0000-4000-8000-000000000012', '00000000-0000-4000-8000-000000000050', '00000000-0000-4000-8000-000000000072', '00000000-0000-4000-8000-000000000073', '00000000-0000-4000-8000-000000000074'];
    }

    function validStaticMultiple(itemId) {
      return itemId in ['00000000-0000-4000-8000-000000000010', '00000000-0000-4000-8000-000000000044', '00000000-0000-4000-8000-000000000056', '00000000-0000-4000-8000-000000000057', '00000000-0000-4000-8000-000000000015', '00000000-0000-4000-8000-000000000020', '00000000-0000-4000-8000-000000000029', '00000000-0000-4000-8000-000000000030', '00000000-0000-4000-8000-000000000024', '00000000-0000-4000-8000-000000000025', '00000000-0000-4000-8000-000000000052', '00000000-0000-4000-8000-000000000062', '00000000-0000-4000-8000-000000000027', '00000000-0000-4000-8000-000000000028', '00000000-0000-4000-8000-000000000091', '00000000-0000-4000-8000-000000000063', '55555555-5555-4555-8555-555555555555', '00000000-0000-4000-8000-000000000033', '00000000-0000-4000-8000-000000000034', '00000000-0000-4000-8000-000000000035', '00000000-0000-4000-8000-000000000047', '00000000-0000-4000-8000-000000000049', '00000000-0000-4000-8000-000000000064', '00000000-0000-4000-8000-000000000065', '00000000-0000-4000-8000-000000000066', '00000000-0000-4000-8000-000000000008', '00000000-0000-4000-8000-000000000009', '00000000-0000-4000-8000-000000000094', '00000000-0000-4000-8000-000000000095', '44444444-4444-4444-8444-444444444444', '00000000-0000-4000-8000-000000000011', '00000000-0000-4000-8000-000000000036', '00000000-0000-4000-8000-000000000031', '00000000-0000-4000-8000-000000000045', '00000000-0000-4000-8000-000000000037', '00000000-0000-4000-8000-000000000038', '00000000-0000-4000-8000-000000000039', '00000000-0000-4000-8000-000000000040', '00000000-0000-4000-8000-000000000041', '00000000-0000-4000-8000-000000000042', '00000000-0000-4000-8000-000000000043', '00000000-0000-4000-8000-000000000018', '00000000-0000-4000-8000-000000000067', '00000000-0000-4000-8000-000000000068', '00000000-0000-4000-8000-000000000069', '00000000-0000-4000-8000-000000000070', '00000000-0000-4000-8000-000000000071', '00000000-0000-4000-8000-000000000021', '00000000-0000-4000-8000-000000000019', '00000000-0000-4000-8000-000000000077', '00000000-0000-4000-8000-000000000082', '00000000-0000-4000-8000-000000000085'];
    }

    function validLimited(d, claimId) {
      return d.kind == 'limited'
        && claimId in ['l_00000000-0000-4000-8000-000000000086_0', 'l_00000000-0000-4000-8000-000000000086_1', 'l_00000000-0000-4000-8000-000000000086_2', 'l_00000000-0000-4000-8000-000000000086_3', 'l_00000000-0000-4000-8000-000000000086_4', 'l_00000000-0000-4000-8000-000000000086_5', 'l_00000000-0000-4000-8000-000000000087_0', 'l_00000000-0000-4000-8000-000000000087_1', 'l_00000000-0000-4000-8000-000000000087_2', 'l_00000000-0000-4000-8000-000000000087_3', 'l_00000000-0000-4000-8000-000000000087_4', 'l_00000000-0000-4000-8000-000000000087_5', 'l_00000000-0000-4000-8000-000000000088_0', 'l_00000000-0000-4000-8000-000000000088_1', 'l_00000000-0000-4000-8000-000000000088_2', 'l_00000000-0000-4000-8000-000000000088_3', 'l_00000000-0000-4000-8000-000000000088_4', 'l_00000000-0000-4000-8000-000000000088_5', 'l_00000000-0000-4000-8000-000000000092_0', 'l_00000000-0000-4000-8000-000000000092_1', 'l_00000000-0000-4000-8000-000000000092_2']
        && claimId.matches('^l_' + d.itemId + '_[0-9]+$')
        && ((d.itemId == '00000000-0000-4000-8000-000000000086' && d.slot >= 0 && d.slot < 6)
          || (d.itemId == '00000000-0000-4000-8000-000000000087' && d.slot >= 0 && d.slot < 6)
          || (d.itemId == '00000000-0000-4000-8000-000000000088' && d.slot >= 0 && d.slot < 6)
          || (d.itemId == '00000000-0000-4000-8000-000000000092' && d.slot >= 0 && d.slot < 3));
    }

    function validClaim(claimId) {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasAll(['itemId', 'ownerUid', 'kind', 'slot', 'createdAt'])
        && d.keys().hasOnly(['itemId', 'ownerUid', 'kind', 'slot', 'createdAt'])
        && d.itemId is string
        && d.ownerUid == request.auth.uid
        && d.createdAt == request.time
        && (
          (d.kind == 'single'
            && d.slot == null
            && validStaticSingle(d.itemId)
            && claimId == 's_' + d.itemId)
          || (d.kind == 'multiple'
            && d.slot == null
            && validStaticMultiple(d.itemId)
            && claimId == 'm_' + d.itemId + '_' + request.auth.uid)
          || validLimited(d, claimId)
          || (d.kind == 'custom'
            && d.slot == null
            && claimId == 'c_' + d.itemId
            && exists(/databases/$(database)/documents/customItems/$(d.itemId)))
        );
    }

    match /claims/{claimId} {
      allow read: if signedIn();
      allow create: if validClaim(claimId);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /customItems/{itemId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['title', 'ownerUid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'ownerUid', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/claims/$(('c_' + itemId)));
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

